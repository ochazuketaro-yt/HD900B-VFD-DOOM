+/* ---- evdev keyboard (FBDOOM_EVDEV=/dev/input/eventN, FBDOOM_GRAB=1 for EVIOCGRAB): Linux keycodes = low AT scancodes ---- */
+static int evfd = -1;
+struct evrec { unsigned int sec, usec; unsigned short type, code; int value; };
+static unsigned char EvKey(unsigned int code)
+{
+    switch (code) {
+    case 17: return KEY_UPARROW;     /* W */
+    case 31: return KEY_DOWNARROW;   /* S */
+    case 30: return KEY_LEFTARROW;   /* A */
+    case 32: return KEY_RIGHTARROW;  /* D */
+    case 72: return KEY_UPARROW;     /* keypad 8 */
+    case 80: return KEY_DOWNARROW;   /* keypad 2 */
+    case 75: return KEY_LEFTARROW;   /* keypad 4 */
+    case 77: return KEY_RIGHTARROW;  /* keypad 6 */
+    case 82: return KEY_FIRE;        /* keypad 0 */
+    case 28: return KEY_ENTER;
+    }
+    return code < sizeof(at_to_doom) ? at_to_doom[code] : 0;
+}
+extern int vfd_ui_state, vfd_menu_sel, vfd_game_started, vfd_god, vfd_spawn;   /* i_video_fbdev.c: 0 play, 1 logo, 2 menu */
+static unsigned char evheld[128];                           /* codes currently held by the game (so a menu opening can release them) */
+static void UiKey(unsigned int code, int value)
+{   /* menu: W/up = previous, S/down = next, keypad 0 / Enter = select, keypad 1 = cancel. items: ORIG WAVE FREE EXIT */
+    if (!value) return;
+    if (vfd_ui_state == 1) return;                           /* logo: ignore keys */
+    if (code == 17 || code == 103) vfd_menu_sel = (vfd_menu_sel + 3) & 3;
+    else if (code == 31 || code == 108) vfd_menu_sel = (vfd_menu_sel + 1) & 3;
+    else if (code == 82 || code == 28) {
+        if (vfd_menu_sel == 3) { kbd_shutdown(); I_Quit(); }
+        vfd_god = vfd_menu_sel != 0; vfd_spawn = vfd_menu_sel == 1;       /* ORIG: normal | WAVE: god + zombies | FREE: god, no extra enemies */
+        G_DeferedInitNew(sk_medium, 1, 1); paused = false; vfd_game_started = 1; vfd_ui_state = 0;
+    } else if (code == 79 && vfd_game_started) { paused = false; vfd_ui_state = 0; }   /* cancel = back to the game */
+}
+static void EvdevPoll(void)
+{
+    struct evrec e;
+    while (read(evfd, &e, sizeof e) == (ssize_t)sizeof e) {
+        event_t event;
+        if (e.type != 1 || e.value == 2) continue;          /* EV_KEY press/release only (no autorepeat) */
+        if (e.code == 14 && e.value == 1) { kbd_shutdown(); I_Quit(); }   /* Backspace = quit */
+        if (getenv("FBDOOM_UI") && e.code == 1) continue;     /* Esc would open the (invisible) stock DOOM menu */
+        if (getenv("FBDOOM_UI")) {
+            if (vfd_ui_state != 0) { UiKey(e.code, e.value); continue; }
+            if (e.code == 79 && e.value == 1) {                     /* keypad 1 during play: open the menu, release held keys first */
