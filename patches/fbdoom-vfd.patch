+        for (cx = 0; cx < 45; cx++) for (cy = 0; cy < 7; cy++) hist[lum[cx][cy]]++;
+        for (lo = 0; lo < 255 && acc + hist[lo] < 25; lo++) acc += hist[lo];
+        acc = 0; for (hi = 255; hi > 0 && acc + hist[hi] < 25; hi--) acc += hist[hi];
