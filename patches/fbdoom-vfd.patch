+                for (c = 0; c < 128; c++) if (evheld[c]) { event_t up; up.type = ev_keyup; up.data1 = EvKey(c); up.data2 = up.data3 = 0; if (up.data1) D_PostEvent(&up); evheld[c] = 0; }
+                vfd_ui_state = 2; vfd_menu_sel = 0; paused = true; continue;
+            }
+        }
+        if (e.code < 128) evheld[e.code] = e.value ? 1 : 0;
+        event.data1 = EvKey(e.code); event.data2 = 0; event.data3 = 0;
+        if (!event.data1) continue;
+        event.type = e.value ? ev_keydown : ev_keyup;
+        if (e.value) event.data2 = event.data1 >= 'a' && event.data1 <= 'z' ? event.data1 : 0;
+        D_PostEvent(&event);
+    }
+}
